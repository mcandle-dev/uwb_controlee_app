<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.uwb"
        android:required="true" />

    <!-- OOB(BLE)는 부가 경로 — BLE 미지원 기기에서도 설치·수동 흐름 가능해야 함 -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <uses-permission android:name="android.permission.UWB_RANGING" />

    <!-- FR-14: API 31+ 런타임 권한. ADVERTISE는 위치 권한 불필요 -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- spec 001 모드 3 (SCANNER): 콘솔 광고 관찰용. 위치 추정 미사용 — 모드 3 선택 시에만 런타임 요청 (D5) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- NFR-3: 세션 유지용 FGS. connectedDevice 타입 전제 권한은 BLUETOOTH_*·UWB_RANGING으로 충족 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- API 33+ 알림 표시용 (거부돼도 FGS 동작에는 영향 없음 — 알림만 숨겨짐) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- spec 002 콜드 웨이크 성립 조건 (P8 예외, T304 실측): 배터리 최적화 제외 앱만
         백그라운드 FGS 시작 허용 — 자동 감시 토글 ON 시 허용 대화상자를 띄운다 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:label="UWB Controlee v2"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RangingForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- spec 002 T302: 콜드 웨이크 — OS 가 PendingIntent 스캔 매치 시 명시적으로 깨움 -->
        <receiver
            android:name=".uwb.OobWakeReceiver"
            android:exported="false" />
    </application>

</manifest>
